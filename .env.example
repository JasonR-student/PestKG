SITE_ADDRESS=https://pestkg.example.org
PESTKG_HTTP_PORT=80
PESTKG_HTTPS_PORT=443
CADDY_IMAGE=caddy:2.11.4-alpine
PESTKG_RELEASE_ID=2026.08.3_federated
PESTKG_RELEASE_ROOT=/srv/pestkg/releases
PESTKG_STATE_ROOT=/srv/pestkg/state
PESTKG_CORS_ORIGINS=https://pestkg.example.org
PESTKG_NEO4J_URI=
PESTKG_NEO4J_USER=neo4j
PESTKG_NEO4J_PASSWORD=
NEO4J_AUTH=neo4j/change-me
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# Windows RAR preparation only; omit when 7z is already on PATH.
SEVEN_ZIP=C:\Program Files\7-Zip\7z.exe
# Optional build mirrors for restricted networks.
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org
PESTKG_IMAGE_NAMESPACE=ghcr.io/example/pestkg
PESTKG_IMAGE_TAG=1.1.0
BUILD_DATE=2026-08-29T00:00:00Z
VCS_REF=replace-with-git-commit
