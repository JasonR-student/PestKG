# ============================================
# PestKG 部署配置文件
# 用法：把下面的 占位符 替换成你自己的信息
# ============================================

# 【必填】你的网站域名（不要加 http://，不要加斜杠）
# 例如：pestkg.example.com 或 kg.yourdomain.cn
SITE_ADDRESS=https://你的域名

# 端口（一般不用改）
PESTKG_HTTP_PORT=80
PESTKG_HTTPS_PORT=443

# Caddy 反向代理镜像（一般不用改）
CADDY_IMAGE=caddy:2.11.4-alpine

# 默认数据版本 ID（prepare_release.py 处理后会生成这个目录名）
PESTKG_RELEASE_ID=2026.08.3_federated

# 服务器上的数据目录（按手册创建，一般不用改）
PESTKG_RELEASE_ROOT=/srv/pestkg/releases
PESTKG_STATE_ROOT=/srv/pestkg/state

# 【必填】跨域允许的来源，一般和 SITE_ADDRESS 一样
PESTKG_CORS_ORIGINS=https://你的域名

# ============================================
# 图谱模式选择
# ============================================
# 【模式A：轻量模式】只用 DuckDB/Parquet，不启动 Neo4j（推荐先试这个）
# 保持下面两行留空即可：
PESTKG_NEO4J_URI=
PESTKG_NEO4J_PASSWORD=

# 【模式B：完整图谱模式】启用 Neo4j 图谱查询
# 注释掉上面两行，取消下面三行注释，并设置强密码：
#PESTKG_NEO4J_URI=bolt://neo4j:7687
#PESTKG_NEO4J_PASSWORD=你的高强度密码_至少16位_混合大小写数字符号
#NEO4J_AUTH=neo4j/和上面一样的密码

# Neo4j 端口（一般不用改，且已绑定 127.0.0.1 不对外暴露）
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ============================================
# 镜像配置（关键！你用的是本地导出的离线镜像）
# ============================================
# 你的镜像包文件名是 pestkg-images-1.1.0-local.tar.gz
# 所以命名空间是 pestkg，标签是 1.1.0-local
PESTKG_IMAGE_NAMESPACE=pestkg
PESTKG_IMAGE_TAG=1.1.0-local

# ============================================
# 冒烟测试用的公网地址（和 SITE_ADDRESS 一致）
# ============================================
PESTKG_BASE_URL=https://你的域名

# ============================================
# 以下为构建相关参数，生产部署不用改
# ============================================
SEVEN_ZIP=C:\Program Files\7-Zip\7z.exe
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org
BUILD_DATE=2026-08-29T00:00:00Z
VCS_REF=local-deploy
